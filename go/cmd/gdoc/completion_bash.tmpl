# bash completion for gdoc, written by gdoc itself:
#
#   gdoc completion bash --out <path>
#
# {{.Usage}}
#
# Every command and every flag below came out of the binary that wrote this
# file. Write the file again after an upgrade, which is what install.sh does.
# Source it from .bashrc.

_gdoc() {
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # What a flag carries. A file is offered, and a Drive folder id, a cursor and
  # a wait length are offered nothing, because nothing on this machine knows one.
  case "$prev" in
{{- if .FileFlags}}
    {{.FileFlags}}) COMPREPLY=( $(compgen -f -- "$cur") ); return ;;
{{- end}}
{{- if .OpaqueFlags}}
    {{.OpaqueFlags}}) return ;;
{{- end}}
  esac

  if [[ $COMP_CWORD -le 1 ]]; then
    COMPREPLY=( $(compgen -W "{{.Words}}" -- "$cur") )
    return
  fi

  # The words a command takes are a document URL, a comment id or a suggestion
  # id, so only the flags are offered under each one.
  case "${COMP_WORDS[1]}" in
{{- range .Groups}}
  {{.Word}})
{{- if .Subs}}
    if [[ $COMP_CWORD -le 2 ]]; then
      COMPREPLY=( $(compgen -W "{{.Words}}" -- "$cur") )
      return
    fi
    case "${COMP_WORDS[2]}" in
{{- range .Subs}}
    {{.Word}}){{if .Words}} COMPREPLY=( $(compgen -W "{{.Words}}" -- "$cur") ){{end}} ;;
{{- end}}
    esac
    ;;
{{- else}}
{{- if .Words}}
    COMPREPLY=( $(compgen -W "{{.Words}}" -- "$cur") )
{{- end}}
    ;;
{{- end}}
{{- end}}
  esac
}

complete -F _gdoc gdoc
