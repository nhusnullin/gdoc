{"ok":true,"data":{"commands":[{"name":"auth status","words":[],"flags":[],"summary":"Say whether gdoc has a token, when it expires, and what it may reach.","example":"gdoc auth status"},{"name":"auth login","words":[],"flags":[],"summary":"Print the Google sign-in URL and wait for the browser to come back.","example":"gdoc auth login"},{"name":"auth logout","words":[],"flags":[],"summary":"Remove the token from this computer. The grant stays at Google until you take it away in your account settings.","example":"gdoc auth logout"},{"name":"read","words":["<url>"],"flags":[{"name":"--structure","value":"","need":"optional","summary":"print the tree of tabs, headings and tables instead of the text"}],"summary":"Print the document as text, with the ids a comment or a suggestion is named by.","example":"gdoc read https://docs.google.com/document/d/1AbC.../edit"},{"name":"comments","words":["<url>"],"flags":[{"name":"--since","value":"<cursor>","need":"optional","summary":"only what is newer than this cursor, which an earlier run printed"},{"name":"--witness","value":"","need":"optional","summary":"export the document and say which threads the export still shows"},{"name":"--wait","value":"<duration>","need":"optional","summary":"wait this long for something new before answering, written as 9m or 90s"},{"name":"--follow","value":"<duration>","need":"optional","summary":"keep looking for this long, printing one line per window that carries something marked for gdoc"}],"summary":"List the comment threads with their ranges, their replies and the next cursor.","example":"gdoc comments https://docs.google.com/document/d/1AbC.../edit --since <cursor> --follow 29m"},{"name":"suggestions","words":["<url>"],"flags":[{"name":"--md","value":"<file>","need":"optional","summary":"the note paired with this document, to say which of gdoc's own proposals have gone"}],"summary":"List the suggestions pending in the document.","example":"gdoc suggestions https://docs.google.com/document/d/1AbC.../edit --md note.md"},{"name":"export","words":["<url>"],"flags":[{"name":"--out","value":"<file>","need":"required","summary":"the Markdown file to write, or the note this document is already paired with"}],"summary":"Write the document into the hub as Markdown, one file per tab, with its pictures beside it.","example":"gdoc export https://docs.google.com/document/d/1AbC.../edit --out note.md"},{"name":"restyle","words":["<url>"],"flags":[{"name":"--dry-run","value":"","need":"either","summary":"survey the document and write nothing into it"},{"name":"--from","value":"<file>","need":"either","summary":"the survey a dry run wrote, which says the document has not moved since"},{"name":"--fields","value":"<file>","need":"optional","summary":"the cover values, which propose the house template as well as the styling"}],"summary":"Survey a document against the house style, or apply that style where the document stands.","example":"gdoc restyle https://docs.google.com/document/d/1AbC.../edit --dry-run"},{"name":"probe","words":[],"flags":[{"name":"--folder","value":"<folder id>","need":"required","summary":"the Drive folder the throwaway document is created in"}],"summary":"Create a throwaway document and say whether Docs honours a suggestion today.","example":"gdoc probe --folder 1AbC..."},{"name":"reply","words":["<url>","<comment id>"],"flags":[{"name":"--body","value":"<text>","need":"either","summary":"the words of the reply, typed on the line"},{"name":"--body-file","value":"<file>","need":"either","summary":"the file holding the words of the reply"}],"summary":"Write one reply into a comment thread, under your mark.","example":"gdoc reply https://docs.google.com/document/d/1AbC.../edit AAAA1234 --body-file reply.txt"},{"name":"propose","words":["<url>"],"flags":[{"name":"--from","value":"<file>","need":"required","summary":"the file holding the changes to propose: an entry is either words inside one paragraph (quoted, replacement) or a block of new paragraphs (kind: block, content, and after or replace_from and replace_to), and every entry carries why, the reason a thread will show"},{"name":"--md","value":"<file>","need":"optional","summary":"the note to record the proposals in, so they can be taken back later"},{"name":"--folder","value":"<folder id>","need":"optional","summary":"ignored: propose no longer creates a working copy, and the flag will be removed in a later release"}],"summary":"Propose changes as native suggestions, each with the comment that says why.","example":"gdoc propose https://docs.google.com/document/d/1AbC.../edit --from changes.json --md note.md"},{"name":"withdraw","words":["<url>","<suggestion id>"],"flags":[{"name":"--md","value":"<file>","need":"required","summary":"the note that records which suggestions gdoc wrote"}],"summary":"Take back one pending suggestion, and only one gdoc proposed itself.","example":"gdoc withdraw https://docs.google.com/document/d/1AbC.../edit suggest.abc123 --md note.md"},{"name":"annotate","words":["<url>"],"flags":[{"name":"--quote","value":"<text>","need":"either","summary":"the exact words in the document to leave the comment on"},{"name":"--from","value":"<file>","need":"either","summary":"the file holding the comments to leave, each with the words it goes on"},{"name":"--body-file","value":"<file>","need":"optional","summary":"the file holding the reason, which --quote needs"}],"summary":"Leave a comment on the exact words you quote, under your mark, changing nothing.","example":"gdoc annotate https://docs.google.com/document/d/1AbC.../edit --from annotations.json"},{"name":"build","words":[],"flags":[{"name":"--md","value":"<file>","need":"required","summary":"the note to build"},{"name":"--out","value":"<file>","need":"required","summary":"the docx file to write"},{"name":"--house","value":"<file>","need":"optional","summary":"a house style file other than the one inside gdoc"},{"name":"--force","value":"","need":"optional","summary":"replace the out file if something is already there"}],"summary":"Build the note as a house-style docx on this machine, reaching only for the house logo.","notes":["A footnote is set under the page: [^1] where the mark goes and [^1]: the words on a line of their own, numbered in the order a reader meets the marks. A mark that names no note, a note nothing marks, one label defined twice, and a mark inside a heading or a table cell are refused naming the line.","==words== and a colour emoji opening a highlight are Obsidian's own marks, and a comment is a grey aside: <!-- words --> or Obsidian's %% words %%, inside a sentence or on lines of its own. [words]{.pencil}, the span the aside was written as before milestone 20, is refused naming the line. Run gdoc help marks for the seven, their colours, and which three are counted on this envelope.","--- on a line of its own is a page break: the document starts a new page there, and ***, ___ and - - - are that same break. A break before nothing, at the end of a note or before its footnote definitions, and a break directly before another one, are left out, because the page they open holds nothing. body.page_breaks on this envelope is the pages the document got, not the lines the note held."],"example":"gdoc build --md note.md --out note.docx"},{"name":"publish","words":[],"flags":[{"name":"--md","value":"<file>","need":"required","summary":"the note to publish"},{"name":"--folder-id","value":"<folder id>","need":"required","summary":"the Drive folder the document is created in"},{"name":"--house","value":"<file>","need":"optional","summary":"a house style file other than the one inside gdoc"}],"summary":"Build the note as a house-style document and upload it into one folder.","example":"gdoc publish --md note.md --folder-id 1AbC..."},{"name":"update","words":[],"flags":[{"name":"--check","value":"","need":"optional","summary":"say what a run would take, and write nothing"},{"name":"--major","value":"","need":"optional","summary":"take a release across a major boundary, which is never taken without this"},{"name":"--nightly","value":"","need":"optional","summary":"take the newest release there is, cut by the nightly or by hand"},{"name":"--rollback","value":"","need":"optional","summary":"put the binary that was here before the last update back"},{"name":"--desktop","value":"","need":"optional","summary":"write the Claude Desktop extension from the release this run installed, and open it"}],"summary":"Replace this gdoc with the newest release, or say what one would take.","example":"gdoc update"},{"name":"mcp","words":[],"flags":[],"summary":"Serve gdoc to Claude Desktop over stdin and stdout, as a protocol session rather than one object.","example":"gdoc mcp"},{"name":"help","words":["<command>"],"flags":[{"name":"--json","value":"","need":"optional","summary":"print the JSON object even on a terminal, and keep stderr plain"},{"name":"--brief","value":"","need":"optional","summary":"print the mark in effect and the release notice alone, without the table"}],"summary":"Print every command gdoc takes, or the words and flags of one.","example":"gdoc help publish"},{"name":"completion","words":["<shell>"],"flags":[{"name":"--out","value":"<file>","need":"required","summary":"the file to write the completion script to"},{"name":"--force","value":"","need":"optional","summary":"replace the out file if something is already there"}],"summary":"Write the completion script for one shell, and say the line that turns it on.","example":"gdoc completion zsh --out ~/.gdoc-completion.zsh"}],"settings":{"mark":"⁘","mark_from":"default"},"update":{"installed":"v2.9.0","latest_stable":"v2.10.0","latest_nightly":"v2.10.1","checked_at":"2026-10-03T00:00:00Z"}},"version":"v2.9.0"}
