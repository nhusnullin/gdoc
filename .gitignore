__pycache__/
*.py[cod]
.coverage
htmlcov/
*.egg-info/
build/
dist/
.DS_Store

# Obsidian workspace state, personal and not part of the tool
.obsidian/

# Live git worktrees and per-machine settings. The branches are in git already,
# so nothing here is the only copy of anything.
.claude/worktrees/
.claude/settings.local.json

# Compiled Go binaries, rebuilt by `make build` and `make dist`
bin/

# the live test's recordings hold a real document's content; the shape lives in go/internal/docs/testdata/anchors.json
go/internal/live/testdata/

# A `go build` run from inside go/cmd/gdoc leaves the binary beside the source.
# `bin/` above does not cover that path, and one got committed once.
go/cmd/gdoc/gdoc
